# Alamat backend Go SESUNGGUHNYA - SENGAJA TANPA prefix NEXT_PUBLIC_, supaya
# nilai ini HANYA pernah dibaca di proses Node (next.config.js rewrites),
# dan TIDAK PERNAH ikut ter-bundle ke JavaScript yang dikirim ke browser.
# Browser hanya pernah tahu path relatif "/backend/..." (lihat src/app/api.ts).
BACKEND_INTERNAL_URL=http://localhost:8080/api

NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=60

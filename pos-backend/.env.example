PORT=8080
HOST=0.0.0.0

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=nota_pos
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_ENCRYPT=false
DB_TRUST_CERT=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_MAX_AGE_MS=28800000
COOKIE_SECURE=false

PAYMENT_GATEWAY_KEY=your_midtrans_or_xendit_server_key
PAYMENT_GATEWAY_URL=https://api.sandbox.midtrans.com

# Comma-separated list of frontend origins allowed to call this API with
# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies) DIRECTLY - not required for normal operation since
# the frontend now proxies all calls via Next.js rewrites (see
# pos-frontend/next.config.js), making browser requests same-origin and
# immune to CORS entirely. Kept as a defense-in-depth fallback for any
# direct browser-to-backend access scenario.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# LOG_DIR default: ./logs (relative to where the binary runs)
